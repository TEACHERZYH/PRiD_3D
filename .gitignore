# ---- 编译产物 ----
*.aux
*.log
*.out
*.bbl
*.blg
*.abs
*.fls
*.fdb_latexmk
*.synctex.gz
main.pdf
paper_draft.docx
paper_preview.html
title_page.pdf
title_page.docx
~$*

# ---- 大文件 / 数据 / 模型 ----
*.zip
*.exe
*.pt
*.pth
*.ckpt
*.npz
data/
results/

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/

# ---- 论文（不推送到代码仓库）----
paper/

# ---- 实验记录 / 实验计划（不推送到代码仓库，只推代码）----
experiments/*.md
experiments/*.sh

# ---- 研究提案 / 方案文档（不推送到代码仓库，只推代码）----
docs/*.md

# ---- 根目录项目文档（README/AGENTS/CHANGELOG 含研究内容，不推送）----
/*.md

# ---- 论文配图脚本（含硬编码的论文结果数字，不推送到代码仓库）----
code/draw_framework.py
code/re_render_figures.py

# ---- 论文工程工具（配图/数值校验/文献抓取/LaTeX 展平，非结果复现代码）----
code/paper_tools/

# ---- 临时文件 ----
*.tmp

# ---- 系统文件 ----
.DS_Store
Thumbs.db
